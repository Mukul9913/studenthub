# StudentHub Monorepo Environment Configuration Example
# Copy options to respective apps/.env files or set in your environment

# API Service Configuration (apps/api/.env)
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
API_PREFIX=/api
MONGODB_URI=mongodb://127.0.0.1:27017/studenthub
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
TRUST_PROXY=1
REQUEST_SIZE_LIMIT=1mb

# Optional Cloudinary Media Storage (apps/api/.env)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web Client Configuration (apps/web/.env)
VITE_API_URL=http://localhost:5000/api
